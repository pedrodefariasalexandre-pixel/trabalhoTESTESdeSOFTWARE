<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.edu.qa</groupId>
    <artifactId>karate-dummyjson-api-tests</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Karate - Testes de API DummyJSON</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Karate 2.x exige Java 21+ -->
        <maven.compiler.release>21</maven.compiler.release>
        <karate.version>2.1.4</karate.version>
        <junit.version>6.1.3</junit.version>
    </properties>

    <dependencies>
        <!-- Karate 2 (runner + integração JUnit 6) -->
        <dependency>
            <groupId>io.karatelabs</groupId>
            <artifactId>karate-junit6</artifactId>
            <version>${karate.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- No Karate 2 o JUnit precisa ser declarado explicitamente -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Implementação de log (SLF4J) para ver as requisições no console -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.6.6</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Convenção do Karate: .feature/.json/.js ficam ao lado das classes Java em src/test/java -->
        <testResources>
            <testResource>
                <directory>src/test/java</directory>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
                <configuration>
                    <!-- Propriedades passadas com -D no "mvn test" (ex.: -Dkarate.env=hml)
                         chegam automaticamente ao Karate pelo Surefire. -->
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
